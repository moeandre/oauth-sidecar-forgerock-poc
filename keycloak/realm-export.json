{
  "realm": "poc-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clientScopes": [
    {
      "name": "task:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "task:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Permitir criar, editar e excluir tarefas (escrita)"
      }
    },
    {
      "name": "billing:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "billing:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Permitir criar, editar e excluir faturas (escrita)"
      }
    }
  ],
  "clients": [
    {
      "clientId": "tasks-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "tasks-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:8082/*"],
      "webOrigins": ["http://localhost:8082"],
      "defaultClientScopes": ["task:read"],
      "optionalClientScopes": ["task:write"]
    },
    {
      "clientId": "billing-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "billing-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:8082/*"],
      "webOrigins": ["http://localhost:8082"],
      "defaultClientScopes": ["billing:read"],
      "optionalClientScopes": ["billing:write"]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ]
    }
  ]
}
